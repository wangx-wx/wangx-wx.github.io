---
import { FEATURED_PROJECTS } from "@/profile";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
---

<section class="my-10" aria-label="精选项目">
  <div class="mb-5 flex items-baseline gap-3">
    <p class="text-xs tracking-[0.22em] text-accent">PROJECTS</p>
    <h2 class="text-2xl font-semibold sm:text-3xl">精选项目</h2>
  </div>
  <ul class="grid gap-4 sm:grid-cols-1">
    {
      FEATURED_PROJECTS.map(p => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-2xl border border-border bg-muted/40 p-5 transition hover:-translate-y-0.5 hover:border-accent hover:bg-muted/70 hover:shadow-md"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-lg font-semibold transition group-hover:text-accent">
                  {p.name}
                </h3>
                {p.highlight && (
                  <p class="mt-1 text-xs tracking-wider text-accent/80">
                    {p.highlight}
                  </p>
                )}
              </div>
              <IconGitHub class="h-5 w-5 flex-shrink-0 stroke-current stroke-2 opacity-70 transition group-hover:opacity-100" />
            </div>
            <p class="mt-3 text-sm leading-relaxed text-foreground/80">
              {p.description}
            </p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map(tag => (
                <li class="rounded-full bg-background/70 px-2 py-0.5 text-xs text-foreground/70">
                  {tag}
                </li>
              ))}
            </ul>
            <span class="mt-4 inline-flex items-center gap-1 text-sm text-accent">
              查看仓库
              <IconArrowRight class="inline-block h-4 w-4 transition group-hover:translate-x-1 rtl:-rotate-180" />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
