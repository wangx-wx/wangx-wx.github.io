---
import { TECH_STACK } from "@/profile";
---

<section class="my-10" aria-label="技术栈">
  <div class="mb-5 flex items-baseline gap-3">
    <p class="text-xs tracking-[0.22em] text-accent">STACK</p>
    <h2 class="text-2xl font-semibold sm:text-3xl">技术栈</h2>
  </div>
  <div class="space-y-5">
    {
      TECH_STACK.map(group => (
        <div>
          <h3 class="mb-3 text-sm font-medium text-foreground/70">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map(t => (
              <li class="group inline-flex items-center gap-2 rounded-full border border-border bg-muted/60 px-3 py-1.5 text-sm transition hover:-translate-y-0.5 hover:border-accent hover:text-accent">
                {t.emoji && <span aria-hidden>{t.emoji}</span>}
                <span class="font-medium">{t.name}</span>
                {t.note && (
                  <span class="text-xs text-foreground/60 group-hover:text-accent/80">
                    · {t.note}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
